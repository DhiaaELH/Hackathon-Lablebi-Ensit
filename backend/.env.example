# --- Database (PostgreSQL 16 + pgvector) ---
# Leave unset to use the embedded dev server started by `python -m scripts.dev_db`.
DATABASE_URL=postgresql+psycopg://lessonforge:lessonforge@localhost:5432/lessonforge

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
SIGNAL_HMAC_KEY=change-me-too-used-only-for-anonymous-signal-dedupe
TEACHER_INVITE_CODE=demo-teacher-code
COOKIE_SECURE=false

# --- LLM (Claude). If no key is set the app runs in clearly-labelled DEMO MODE ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# --- Retrieval ---
EMBEDDINGS_PROVIDER=hash   # hash (offline, deterministic) | fastembed (pip install fastembed)

# --- Resource Finder (optional; unavailable state shown when empty) ---
SEARCH_API_KEY=

# --- Google Gemini (alternative LLM) ---
# Paste your key after the = sign (https://aistudio.google.com/apikey).
# LLM_PROVIDER=auto uses Claude if ANTHROPIC_API_KEY is set, otherwise Gemini, otherwise demo mode.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
